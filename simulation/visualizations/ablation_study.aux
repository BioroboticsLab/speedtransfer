\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Effect of ablating individual model components on Group~2 rhythmicity amplitude (mean $\pm $ SEM, $n{=}5$ seeds). Speed transfer is the only component whose removal eliminates Group~2 rhythmicity entirely ($A_2 \approx 0.002$, $p = 0.36$). Walls have a secondary amplifying effect, reducing $A_2$ from $0.223$ to $0.059$ (confinement increases contact rate). Homing and turning noise have negligible effects. Homogenizing initial positions slightly \emph  {increases} transfer ($A_2 = 0.234$), since mixing groups spatially produces more early inter-group contacts.}}{1}{figure.1}\protected@file@percent }
\newlabel{fig:single-factor}{{1}{1}{Effect of ablating individual model components on Group~2 rhythmicity amplitude (mean $\pm $ SEM, $n{=}5$ seeds). Speed transfer is the only component whose removal eliminates Group~2 rhythmicity entirely ($A_2 \approx 0.002$, $p = 0.36$). Walls have a secondary amplifying effect, reducing $A_2$ from $0.223$ to $0.059$ (confinement increases contact rate). Homing and turning noise have negligible effects. Homogenizing initial positions slightly \emph {increases} transfer ($A_2 = 0.234$), since mixing groups spatially produces more early inter-group contacts}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Full $2^4$ factorial ablation over four structural components ($n{=}5$ seeds per condition). Left: blue squares indicate the component is active; grey indicates it has been ablated. Right: Group~2 amplitude. Whenever speed transfer is ablated (grey in the third column), Group~2 amplitude collapses to near zero regardless of other component states.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:factorial}{{2}{2}{Full $2^4$ factorial ablation over four structural components ($n{=}5$ seeds per condition). Left: blue squares indicate the component is active; grey indicates it has been ablated. Right: Group~2 amplitude. Whenever speed transfer is ablated (grey in the third column), Group~2 amplitude collapses to near zero regardless of other component states}{figure.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Density ($d$).}{2}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Day duration ($T_{\mathrm  {day}}$).}{2}{section*.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Ablation study: effect of removing individual model components on rhythmicity transfer (mean $\pm $ SEM across $n{=}5$ independent seeds). $A_1$ and $A_2$ are the fitted sinusoidal amplitudes of the Group~1 (forager) and Group~2 (hive bee) mean speed time series, respectively. $\Delta \phi $ is the phase lag of Group~2 relative to Group~1 in degrees, and $p_2$ is the permutation-test $p$-value for Group~2 rhythmicity (200 permutations). Simulations used density factor $d{=}1.0$, day duration $T_{\mathrm  {day}}{=}100$~steps, and decay rate $\gamma {=}0.8$. Speed transfer is the sole essential mechanism; walls provide secondary amplification by confining agents and increasing contact rates.\textsuperscript  {a}}}{3}{table.1}\protected@file@percent }
\newlabel{tab:ablation}{{1}{3}{Ablation study: effect of removing individual model components on rhythmicity transfer (mean $\pm $ SEM across $n{=}5$ independent seeds). $A_1$ and $A_2$ are the fitted sinusoidal amplitudes of the Group~1 (forager) and Group~2 (hive bee) mean speed time series, respectively. $\Delta \phi $ is the phase lag of Group~2 relative to Group~1 in degrees, and $p_2$ is the permutation-test $p$-value for Group~2 rhythmicity (200 permutations). Simulations used density factor $d{=}1.0$, day duration $T_{\mathrm {day}}{=}100$~steps, and decay rate $\gamma {=}0.8$. Speed transfer is the sole essential mechanism; walls provide secondary amplification by confining agents and increasing contact rates.\textsuperscript {a}}{table.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Decay rate ($\gamma $).}{3}{section*.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Sensitivity to agent density ($d \in [0.25, 3.0]$, $T_{\mathrm  {day}}{=}100$, $\gamma {=}0.8$). \textbf  {Left:} Group~2 amplitude $A_2$ increases monotonically with density. \textbf  {Right:} Phase lag $\Delta \phi $ decreases with density, as more available interaction partners accelerate signal propagation. Dashed line marks the baseline ($d{=}1.0$).}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:sensitivity-density}{{3}{4}{Sensitivity to agent density ($d \in [0.25, 3.0]$, $T_{\mathrm {day}}{=}100$, $\gamma {=}0.8$). \textbf {Left:} Group~2 amplitude $A_2$ increases monotonically with density. \textbf {Right:} Phase lag $\Delta \phi $ decreases with density, as more available interaction partners accelerate signal propagation. Dashed line marks the baseline ($d{=}1.0$)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Sensitivity to day duration ($T_{\mathrm  {day}} \in [50, 800]$~steps, $d{=}1.0$, $\gamma {=}0.8$). \textbf  {Left:} Amplitude is nearly constant for $T_{\mathrm  {day}} \geq 75$. \textbf  {Right:} Phase lag scales inversely with day duration, consistent with a fixed propagation delay measured in steps. Dashed line marks the baseline ($T_{\mathrm  {day}}{=}100$).}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:sensitivity-duration}{{4}{4}{Sensitivity to day duration ($T_{\mathrm {day}} \in [50, 800]$~steps, $d{=}1.0$, $\gamma {=}0.8$). \textbf {Left:} Amplitude is nearly constant for $T_{\mathrm {day}} \geq 75$. \textbf {Right:} Phase lag scales inversely with day duration, consistent with a fixed propagation delay measured in steps. Dashed line marks the baseline ($T_{\mathrm {day}}{=}100$)}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Sensitivity to decay rate ($\gamma \in [0.0, 0.9]$, $d{=}1.0$, $T_{\mathrm  {day}}{=}100$). \textbf  {Left:} Amplitude increases with $\gamma $ as longer memory amplifies the accumulated signal. Importantly, transfer is significant ($p < 0.01$) even at $\gamma {=}0$. \textbf  {Right:} Phase lag increases approximately threefold from $\gamma {=}0$ to $\gamma {=}0.9$, reflecting inertia from accumulated memory. Dashed line marks the baseline ($\gamma {=}0.8$).}}{5}{figure.5}\protected@file@percent }
\newlabel{fig:sensitivity-decay}{{5}{5}{Sensitivity to decay rate ($\gamma \in [0.0, 0.9]$, $d{=}1.0$, $T_{\mathrm {day}}{=}100$). \textbf {Left:} Amplitude increases with $\gamma $ as longer memory amplifies the accumulated signal. Importantly, transfer is significant ($p < 0.01$) even at $\gamma {=}0$. \textbf {Right:} Phase lag increases approximately threefold from $\gamma {=}0$ to $\gamma {=}0.9$, reflecting inertia from accumulated memory. Dashed line marks the baseline ($\gamma {=}0.8$)}{figure.5}{}}
