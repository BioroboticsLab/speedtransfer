\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces {\color  {blue}Ablation study: effect of removing individual model components on rhythmicity transfer (mean $\pm $ SEM across $n{=}5$ independent seeds). $A_1$ and $A_2$ are the fitted sinusoidal amplitudes of the Group~1 (forager) and Group~2 (hive bee) mean speed time series, respectively. $\Delta \phi $ is the phase lag of Group~2 relative to Group~1 in degrees, and $p_2$ is the permutation-test $p$-value for Group~2 rhythmicity (200 permutations). Simulations used density factor $d{=}1.0$, day duration $T_{\mathrm  {day}}{=}100$~steps, and decay rate $\gamma {=}0.8$. Speed transfer is the sole essential mechanism; walls provide secondary amplification by confining agents and increasing contact rates.\textsuperscript  {a}}}}{39}{table.caption.57}\protected@file@percent }
\newlabel{tab:ablation}{{16}{39}{\added {Ablation study: effect of removing individual model components on rhythmicity transfer (mean $\pm $ SEM across $n{=}5$ independent seeds). $A_1$ and $A_2$ are the fitted sinusoidal amplitudes of the Group~1 (forager) and Group~2 (hive bee) mean speed time series, respectively. $\Delta \phi $ is the phase lag of Group~2 relative to Group~1 in degrees, and $p_2$ is the permutation-test $p$-value for Group~2 rhythmicity (200 permutations). Simulations used density factor $d{=}1.0$, day duration $T_{\mathrm {day}}{=}100$~steps, and decay rate $\gamma {=}0.8$. Speed transfer is the sole essential mechanism; walls provide secondary amplification by confining agents and increasing contact rates.\textsuperscript {a}}}{table.caption.57}{}}
\@writefile{toc}{\contentsline {paragraph}{Density ($d$).}{39}{section*.59}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Day duration ($T_{\mathrm  {day}}$).}{39}{section*.60}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Decay rate ($\gamma $).}{40}{section*.61}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces {\color  {blue}Full $2^4$ factorial ablation over four structural components ($n{=}5$ seeds per condition). Left: blue squares indicate the component is active; grey indicates it has been ablated. Right: Group~2 amplitude. Whenever speed transfer is ablated (grey in the third column), Group~2 amplitude collapses to near zero regardless of other component states.}}}{41}{figure.caption.56}\protected@file@percent }
\newlabel{fig:factorial}{{S5}{41}{\added {Full $2^4$ factorial ablation over four structural components ($n{=}5$ seeds per condition). Left: blue squares indicate the component is active; grey indicates it has been ablated. Right: Group~2 amplitude. Whenever speed transfer is ablated (grey in the third column), Group~2 amplitude collapses to near zero regardless of other component states.}}{figure.caption.56}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces {\color  {blue}Sensitivity to agent density ($d \in [0.25, 3.0]$, $T_{\mathrm  {day}}{=}100$, $\gamma {=}0.8$). \textbf  {Left:} Group~2 amplitude $A_2$ increases monotonically with density. \textbf  {Right:} Phase lag $\Delta \phi $ decreases with density, as more available interaction partners accelerate signal propagation. Dashed line marks the baseline ($d{=}1.0$).}}}{42}{figure.caption.62}\protected@file@percent }
\newlabel{fig:sensitivity-density}{{S6}{42}{\added {Sensitivity to agent density ($d \in [0.25, 3.0]$, $T_{\mathrm {day}}{=}100$, $\gamma {=}0.8$). \textbf {Left:} Group~2 amplitude $A_2$ increases monotonically with density. \textbf {Right:} Phase lag $\Delta \phi $ decreases with density, as more available interaction partners accelerate signal propagation. Dashed line marks the baseline ($d{=}1.0$).}}{figure.caption.62}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces {\color  {blue}Sensitivity to day duration ($T_{\mathrm  {day}} \in [50, 800]$~steps, $d{=}1.0$, $\gamma {=}0.8$). \textbf  {Left:} Amplitude is nearly constant for $T_{\mathrm  {day}} \geq 75$. \textbf  {Right:} Phase lag scales inversely with day duration, consistent with a fixed propagation delay measured in steps. Dashed line marks the baseline ($T_{\mathrm  {day}}{=}100$).}}}{42}{figure.caption.63}\protected@file@percent }
\newlabel{fig:sensitivity-duration}{{S7}{42}{\added {Sensitivity to day duration ($T_{\mathrm {day}} \in [50, 800]$~steps, $d{=}1.0$, $\gamma {=}0.8$). \textbf {Left:} Amplitude is nearly constant for $T_{\mathrm {day}} \geq 75$. \textbf {Right:} Phase lag scales inversely with day duration, consistent with a fixed propagation delay measured in steps. Dashed line marks the baseline ($T_{\mathrm {day}}{=}100$).}}{figure.caption.63}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces {\color  {blue}Sensitivity to decay rate ($\gamma \in [0.0, 0.9]$, $d{=}1.0$, $T_{\mathrm  {day}}{=}100$). \textbf  {Left:} Amplitude increases with $\gamma $ as longer memory amplifies the accumulated signal. Importantly, transfer is significant ($p < 0.01$) even at $\gamma {=}0$. \textbf  {Right:} Phase lag increases approximately threefold from $\gamma {=}0$ to $\gamma {=}0.9$, reflecting inertia from accumulated memory. Dashed line marks the baseline ($\gamma {=}0.8$).}}}{43}{figure.caption.64}\protected@file@percent }
\newlabel{fig:sensitivity-decay}{{S8}{43}{\added {Sensitivity to decay rate ($\gamma \in [0.0, 0.9]$, $d{=}1.0$, $T_{\mathrm {day}}{=}100$). \textbf {Left:} Amplitude increases with $\gamma $ as longer memory amplifies the accumulated signal. Importantly, transfer is significant ($p < 0.01$) even at $\gamma {=}0$. \textbf {Right:} Phase lag increases approximately threefold from $\gamma {=}0$ to $\gamma {=}0.9$, reflecting inertia from accumulated memory. Dashed line marks the baseline ($\gamma {=}0.8$).}}{figure.caption.64}{}}
