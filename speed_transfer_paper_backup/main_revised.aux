\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces {\color  {blue}Effect of ablating individual model components on Group~2 rhythmicity amplitude (mean $\pm $ SEM, $n{=}5$ seeds). Speed transfer is the only component whose removal eliminates Group~2 rhythmicity entirely ($A_2 \approx 0.002$, $p = 0.36$). Walls have a secondary amplifying effect, reducing $A_2$ from $0.223$ to $0.059$ (confinement increases contact rate). Homing and turning noise have negligible effects. Homogenizing initial positions slightly \emph  {increases} transfer ($A_2 = 0.234$), since mixing groups spatially produces more early inter-group contacts.}}}{35}{figure.caption.45}\protected@file@percent }
\newlabel{fig:single-factor}{{S4}{35}{\added {Effect of ablating individual model components on Group~2 rhythmicity amplitude (mean $\pm $ SEM, $n{=}5$ seeds). Speed transfer is the only component whose removal eliminates Group~2 rhythmicity entirely ($A_2 \approx 0.002$, $p = 0.36$). Walls have a secondary amplifying effect, reducing $A_2$ from $0.223$ to $0.059$ (confinement increases contact rate). Homing and turning noise have negligible effects. Homogenizing initial positions slightly \emph {increases} transfer ($A_2 = 0.234$), since mixing groups spatially produces more early inter-group contacts.}}{figure.caption.45}{}}
